{
  "files": {
    "tools": [
      {
        "name": "read_file",
        "description": "Read the contents of a text file.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Path of the file to read"
            }
          },
          "required": [
            "path"
          ]
        }
      },
      {
        "name": "list_directory",
        "description": "List the entries of a directory.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/srv/projects/.*"
            }
          },
          "required": [
            "path"
          ]
        }
      }
    ]
  },
  "crm": {
    "tools": [
      {
        "name": "search_contacts",
        "description": "Search customer contacts by name or company.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "term": {
              "type": "string",
              "maxLength": 100
            }
          },
          "required": [
            "term"
          ]
        }
      },
      {
        "name": "add_note",
        "description": "Add a note to a customer record.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "contact_id": {
              "type": "string",
              "pattern": "^C-[0-9]{6}$"
            },
            "text": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "required": [
            "contact_id",
            "text"
          ]
        }
      }
    ]
  },
  "weather": {
    "tools": [
      {
        "name": "get_forecast",
        "description": "Get the 5-day forecast for a city.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "city": {
              "type": "string",
              "maxLength": 80
            }
          },
          "required": [
            "city"
          ]
        }
      }
    ]
  },
  "mail": {
    "tools": [
      {
        "name": "send_email",
        "description": "Send an email from the company account.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "to": {
              "type": "string",
              "format": "email"
            },
            "subject": {
              "type": "string",
              "maxLength": 200
            },
            "body": {
              "type": "string"
            }
          },
          "required": [
            "to",
            "subject",
            "body"
          ]
        }
      }
    ]
  },
  "devtools": {
    "tools": [
      {
        "name": "run_command",
        "description": "Run a shell command in the project container.\u200b\u200b\u200b",
        "inputSchema": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string"
            }
          },
          "required": [
            "command"
          ]
        }
      },
      {
        "name": "read_file",
        "description": "Read a file from the mounted host filesystem.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ]
        }
      }
    ]
  },
  "analytics": {
    "tools": [
      {
        "name": "run_query",
        "description": "Run a read-only SQL query against the reporting warehouse.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "sql": {
              "type": "string"
            }
          },
          "required": [
            "sql"
          ]
        }
      }
    ]
  }
}